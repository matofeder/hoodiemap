# Copy to deploy/.env and fill in. Never commit .env.

# Postgres password (any long random string: openssl rand -base64 24)
POSTGRES_PASSWORD=

# Admin token for /import and for creating presentations (openssl rand -base64 24)
HOODIEMAP_ADMIN_TOKEN=

# Where the app listens: 127.0.0.1:8000 (default, behind a reverse proxy on this machine)
# or 0.0.0.0:8000 (reachable from the network)
APP_BIND=127.0.0.1:8000

# Optional: the LLM key when ai.llm is set in deploy/config.yaml (docs/ai-providers.md)
HOODIEMAP_LLM_API_KEY=
